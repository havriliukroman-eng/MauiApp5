@page "/"
@using MauiApp5.Shared.Services
@inject Itrading TradingService
@inject ICurrency CurrencyService
@inject IUser UserService
@inject IWallet WalletService
@inject NavigationManager Nav

<div class ="image">
<div class="banner-container">
    <img src="/18.png" alt="Banner" class="banner-image" />
</div>

<style>
    .banner-container {
        position: relative;
        width: 100%;
        height: 250px;
        overflow: hidden;
        border-radius: 12px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .banner-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .image {
    min-height: 100vh;
    background-image: url('/background.webp');
    background-size: cover;
    background-position: center;
}
</style>
<h3>Обмін валют</h3>

<div>
    <label>User ID:</label>
    <input type="number" @bind="UserId" />
</div>

<div>
    <label>Old Currency:</label>
    <input type="text" @bind="OldCurrency" />
</div>

<div>
    <label>New Currency:</label>
    <input type="text" @bind="NewCurrency" />
</div>

<div>
    <label>Value:</label>
    <input type="number" @bind="Value" />
</div>

<br />

<button style="background-color:#0a0a23; color:#fff " @onclick="Trade">Обміняти</button>
<div><label>
     @dollar
</label></div>
<div>
    <label>
       @grivna
    </label>
</div>
@if (!string.IsNullOrEmpty(Message))
{
    <p>@Message</p>
}
</div>
@code {
    private int UserId = 1;
    private string OldCurrency = "dollar";
    private string NewCurrency = "grivna";
    private decimal Value = 10;
    private string Message = "";
    private decimal dollar;
    private decimal grivna;

    private async void Trade()
    {
        var result = TradingService.Trading(
            UserService.GetUserId("Roman"),
            Value,
           CurrencyService. GetCurrencyId(NewCurrency),
           CurrencyService. GetCurrencyId(OldCurrency)
        );

        Message = result ? "Успішно!" : "Помилка обміну";
        dollar = WalletService.GetUserWallet(UserService.GetUserId("Roman"), CurrencyService.GetCurrencyId(OldCurrency));
        grivna = WalletService.GetUserWallet(UserService.GetUserId("Roman"), CurrencyService.GetCurrencyId(NewCurrency));
        await InvokeAsync(() =>
{
   
    StateHasChanged();
});
    }

}